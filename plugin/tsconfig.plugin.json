{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "~plugin/*": ["src/*"],
      "@agent-tracer/kernel": ["../libs/kernel/src/index.ts"],
      "@agent-tracer/kernel/*": ["../libs/kernel/src/*"]
    }
  },
  "include": ["src"]
}
